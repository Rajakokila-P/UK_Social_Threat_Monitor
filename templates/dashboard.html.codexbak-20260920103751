<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>UK Social Threat Intelligence Monitor</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f4f6f8;
            color: #1f2937;
        }

        header {
            position: relative;
            background: #111827;
            color: white;
            padding: 20px 30px;
        }

        header h1 {
            margin: 0;
            font-size: 28px;
            padding-right: 220px;
        }

        header p {
            margin-top: 6px;
            color: #d1d5db;
        }

        .account-menu {
            position: absolute;
            top: 18px;
            right: 30px;
        }

        .account-button {
            background: #1f2937;
            color: white;
            border: 1px solid #4b5563;
            border-radius: 8px;
            padding: 9px 12px;
            cursor: pointer;
            min-width: 160px;
            text-align: left;
        }

        .account-button:hover {
            background: #374151;
        }

        .account-name {
            font-weight: bold;
        }

        .account-role {
            display: block;
            margin-top: 3px;
            font-size: 11px;
            color: #9ca3af;
        }

        .account-arrow {
            float: right;
            margin-top: -18px;
        }

        .account-dropdown {
            display: none;
            position: absolute;
            right: 0;
            top: 52px;
            width: 210px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
            overflow: hidden;
            z-index: 1000;
        }

        .account-dropdown.show {
            display: block;
        }

        .account-dropdown a,
        .account-dropdown button {
            display: block;
            width: 100%;
            padding: 12px 14px;
            color: #1f2937;
            background: white;
            border: none;
            border-radius: 0;
            text-align: left;
            text-decoration: none;
            cursor: pointer;
            font-size: 14px;
        }

        .account-dropdown a:hover,
        .account-dropdown button:hover {
            background: #f3f4f6;
        }

        .account-dropdown .logout-link {
            color: #b91c1c;
            border-top: 1px solid #e5e7eb;
            font-weight: bold;
        }

        .container {
            padding: 24px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .card {
            background: white;
            border-radius: 10px;
            padding: 18px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            margin: 0 0 10px;
            font-size: 14px;
            color: #6b7280;
        }

        .card .number {
            font-size: 30px;
            font-weight: bold;
        }

        .section {
            background: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 24px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .filter-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-row select,
        .filter-row button {
            padding: 10px;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }

        th,
        td {
            text-align: left;
            padding: 10px;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: top;
        }

        th {
            background: #f9fafb;
        }

        input,
        textarea,
        select,
        button {
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        input,
        textarea {
            padding: 10px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            box-sizing: border-box;
        }

        button {
            padding: 10px 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            background: #111827;
            color: white;
        }

        button:hover {
            background: #1f2937;
        }

        .action-button {
            display: inline-block;
            padding: 8px 12px;
            border-radius: 6px;
            background: #111827;
            color: white;
            text-decoration: none;
            white-space: nowrap;
        }

        .action-button:hover {
            background: #1f2937;
        }

        .download-button {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 6px;
            background: #166534;
            color: white;
            text-decoration: none;
        }

        .download-button:hover {
            background: #14532d;
        }

        .result-box {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 16px;
        }

        .risk-badge,
        .status-badge {
            display: inline-block;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: bold;
            white-space: nowrap;
        }

        .risk-critical {
            background: #fee2e2;
            color: #991b1b;
        }

        .risk-high {
            background: #ffedd5;
            color: #9a3412;
        }

        .risk-medium {
            background: #fef3c7;
            color: #92400e;
        }

        .risk-low {
            background: #dcfce7;
            color: #166534;
        }

        .status-new {
            background: #e5e7eb;
            color: #374151;
        }

        .status-under_review {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .status-monitoring {
            background: #e0e7ff;
            color: #4338ca;
        }

        .status-escalated {
            background: #fee2e2;
            color: #b91c1c;
        }

        .status-closed {
            background: #dcfce7;
            color: #166534;
        }

        .status-false_positive {
            background: #f3f4f6;
            color: #6b7280;
        }

        @media (max-width: 1000px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 700px) {
            header h1 {
                padding-right: 0;
                font-size: 22px;
            }

            header {
                padding-bottom: 82px;
            }

            .account-menu {
                top: auto;
                bottom: 18px;
                left: 30px;
                right: 30px;
            }

            .account-button {
                width: 100%;
            }

            .account-dropdown {
                left: 0;
                right: 0;
                width: 100%;
            }
        }

        @media (max-width: 600px) {
            .cards {
                grid-template-columns: 1fr;
            }

            .filter-row {
                flex-direction: column;
                align-items: stretch;
            }

            .container {
                padding: 14px;
            }
        }
    </style>
</head>

<body>

<header>

    <h1>
        UK Social Threat Intelligence Monitor
    </h1>

    <p>
        Analyst dashboard for authorised/public
        social-media threat triage
    </p>

    <div class="account-menu">

        <button
            type="button"
            class="account-button"
            onclick="toggleAccountMenu()"
        >
            <span class="account-name">
                {{ user.username }}
            </span>

            <span class="account-role">
                {{ user.role }}
            </span>

            <span class="account-arrow">
                ▾
            </span>
        </button>

        <div
            id="accountDropdown"
            class="account-dropdown"
        >

            <a href="/profile">
                Personal Details
            </a>

            <a href="/settings">
                Settings
            </a>

            <a
                href="/logout"
                class="logout-link"
            >
                Logout
            </a>

        </div>

    </div>

</header>


<div class="container">

    <div class="cards">

        <div class="card">
            <h3>Total Cases</h3>
            <div class="number">
                {{ total_cases }}
            </div>
        </div>

        <div class="card">
            <h3>High / Critical</h3>
            <div class="number">
                {{ priority_cases }}
            </div>
        </div>

        <div class="card">
            <h3>Under Review</h3>
            <div class="number">
                {{ under_review }}
            </div>
        </div>

        <div class="card">
            <h3>Monitoring</h3>
            <div class="number">
                {{ monitoring }}
            </div>
        </div>

        <div class="card">
            <h3>Escalated</h3>
            <div class="number">
                {{ escalated }}
            </div>
        </div>

    </div>


    <div class="section">

        <h2>Dashboard Controls</h2>

        <div class="filter-row">

            <button
                type="button"
                onclick="refreshDashboard()"
            >
                Refresh Dashboard
            </button>

            <a
                class="download-button"
                href="/export/cases.csv"
            >
                Download Cases CSV
            </a>

            <label>
                <input
                    type="checkbox"
                    id="autoRefreshToggle"
                    onchange="toggleAutoRefresh()"
                >

                Auto Refresh every 30 seconds
            </label>

            <span id="lastRefreshTime"></span>

        </div>

    </div>


    <div class="section">

        <h2>New Analysis</h2>

        <div
            style="
                display: grid;
                gap: 12px;
            "
        >

            <input
                type="text"
                id="platformInput"
                placeholder="Platform, e.g. X"
            >

            <input
                type="text"
                id="usernameInput"
                placeholder="Username"
            >

            <input
                type="text"
                id="displayNameInput"
                placeholder="Display name (optional)"
            >

            <input
                type="text"
                id="locationInput"
                placeholder="Public location (optional)"
            >

            <textarea
                id="postTextInput"
                rows="5"
                placeholder="Paste authorised/public social-media text here..."
            ></textarea>

            <button
                type="button"
                onclick="analysePost()"
            >
                Analyse Post
            </button>

        </div>

        <div
            id="analysisResult"
            style="margin-top: 16px;"
        ></div>

    </div>


    <div class="section">

        <h2>
            Search, Filter & Sort Cases
        </h2>

        <input
            type="text"
            id="searchInput"
            placeholder="Search by ID, username, platform, status, risk level..."
            onkeyup="filterTables()"
            style="
                width: 100%;
                padding: 10px;
                margin-bottom: 12px;
                box-sizing: border-box;
            "
        >

        <div class="filter-row">

            <select
                id="statusFilter"
                onchange="filterTables()"
            >
                <option value="">
                    All Statuses
                </option>

                <option value="NEW">
                    NEW
                </option>

                <option value="UNDER_REVIEW">
                    UNDER_REVIEW
                </option>

                <option value="MONITORING">
                    MONITORING
                </option>

                <option value="ESCALATED">
                    ESCALATED
                </option>

                <option value="CLOSED">
                    CLOSED
                </option>

                <option value="FALSE_POSITIVE">
                    FALSE_POSITIVE
                </option>
            </select>

            <select
                id="riskFilter"
                onchange="filterTables()"
            >
                <option value="">
                    All Risk Levels
                </option>

                <option value="critical">
                    Critical
                </option>

                <option value="high">
                    High
                </option>

                <option value="medium">
                    Medium
                </option>

                <option value="low">
                    Low
                </option>
            </select>

            <select
                id="sortCases"
                onchange="sortTables()"
            >
                <option value="risk_desc">
                    Highest Risk First
                </option>

                <option value="risk_asc">
                    Lowest Risk First
                </option>

                <option value="newest">
                    Newest First
                </option>

                <option value="oldest">
                    Oldest First
                </option>

                <option value="id_asc">
                    ID Ascending
                </option>

                <option value="id_desc">
                    ID Descending
                </option>
            </select>

            <button
                type="button"
                onclick="clearFilters()"
            >
                Clear Filters
            </button>

        </div>

    </div>


    <div class="section">

        <h2>Priority Cases</h2>

        <div class="table-wrapper">

            <table id="priorityTable">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Platform</th>
                        <th>Username</th>
                        <th>Post</th>
                        <th>Risk</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    {% for record in priority_records %}

                    <tr
                        data-id="{{ record.id }}"
                        data-risk="{{ record.risk_score }}"
                        data-created="{{ record.created_at }}"
                        data-status="{{ record.case_status|lower }}"
                    >

                        <td>
                            {{ record.id }}
                        </td>

                        <td>
                            {{ record.platform }}
                        </td>

                        <td>
                            {{ record.username }}
                        </td>

                        <td>
                            {{ record.translated_text or record.original_text }}
                        </td>

                        <td>

                            <span
                                class="risk-badge risk-{{ record.risk_level }}"
                            >
                                {{ record.risk_score }}
                                /
                                {{ record.risk_level }}
                            </span>

                        </td>

                        <td>

                            <select
                                onchange="updateStatus(
                                    {{ record.id }},
                                    this.value
                                )"
                            >

                                <option
                                    value="NEW"
                                    {% if record.case_status == "NEW" %}selected{% endif %}
                                >
                                    NEW
                                </option>

                                <option
                                    value="UNDER_REVIEW"
                                    {% if record.case_status == "UNDER_REVIEW" %}selected{% endif %}
                                >
                                    UNDER_REVIEW
                                </option>

                                <option
                                    value="MONITORING"
                                    {% if record.case_status == "MONITORING" %}selected{% endif %}
                                >
                                    MONITORING
                                </option>

                                <option
                                    value="ESCALATED"
                                    {% if record.case_status == "ESCALATED" %}selected{% endif %}
                                >
                                    ESCALATED
                                </option>

                                <option
                                    value="CLOSED"
                                    {% if record.case_status == "CLOSED" %}selected{% endif %}
                                >
                                    CLOSED
                                </option>

                                <option
                                    value="FALSE_POSITIVE"
                                    {% if record.case_status == "FALSE_POSITIVE" %}selected{% endif %}
                                >
                                    FALSE_POSITIVE
                                </option>

                            </select>

                        </td>

                        <td>

                            <a
                                class="action-button"
                                href="/cases/{{ record.id }}"
                            >
                                View Case
                            </a>

                        </td>

                    </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </div>


    <div class="section">

        <h2>Recent Records</h2>

        <div class="table-wrapper">

            <table id="recordsTable">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Platform</th>
                        <th>User</th>
                        <th>Original Language</th>
                        <th>UK Relevant</th>
                        <th>Risk</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    {% for record in records %}

                    <tr
                        data-id="{{ record.id }}"
                        data-risk="{{ record.risk_score }}"
                        data-created="{{ record.created_at }}"
                        data-status="{{ record.case_status|lower }}"
                    >

                        <td>
                            {{ record.id }}
                        </td>

                        <td>
                            {{ record.platform }}
                        </td>

                        <td>
                            {{ record.username }}
                        </td>

                        <td>
                            {{ record.language }}
                        </td>

                        <td>
                            {{ record.uk_relevant }}
                        </td>

                        <td>

                            <span
                                class="risk-badge risk-{{ record.risk_level }}"
                            >
                                {{ record.risk_score }}
                                /
                                {{ record.risk_level }}
                            </span>

                        </td>

                        <td>

                            <span
                                class="status-badge status-{{ record.case_status|lower }}"
                            >
                                {{ record.case_status }}
                            </span>

                        </td>

                        <td>

                            <a
                                class="action-button"
                                href="/cases/{{ record.id }}"
                            >
                                View Case
                            </a>

                        </td>

                    </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>


<script>

function toggleAccountMenu() {

    const dropdown =
        document.getElementById(
            "accountDropdown"
        );

    dropdown.classList.toggle(
        "show"
    );
}


document.addEventListener(
    "click",
    function (event) {

        const menu =
            document.querySelector(
                ".account-menu"
            );

        const dropdown =
            document.getElementById(
                "accountDropdown"
            );

        if (
            menu &&
            dropdown &&
            !menu.contains(
                event.target
            )
        ) {
            dropdown.classList.remove(
                "show"
            );
        }
    }
);


async function updateStatus(
    recordId,
    newStatus
) {

    try {

        const response = await fetch(
            `/records/${recordId}/status`,
            {
                method: "PATCH",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    case_status:
                        newStatus
                })
            }
        );


        const result =
            await response.json();


        if (result.success) {

            alert(
                "Record " +
                recordId +
                " updated to " +
                newStatus
            );

            window.location.reload();

        } else {

            alert(
                "Update failed: " +
                (
                    result.message ||
                    "Unknown error"
                )
            );
        }

    } catch (error) {

        console.error(
            error
        );

        alert(
            "Unable to update case status."
        );
    }
}


function filterTables() {

    const searchValue =
        document
            .getElementById(
                "searchInput"
            )
            .value
            .toLowerCase();


    const statusValue =
        document
            .getElementById(
                "statusFilter"
            )
            .value
            .toLowerCase();


    const riskValue =
        document
            .getElementById(
                "riskFilter"
            )
            .value
            .toLowerCase();


    filterTable(
        "priorityTable",
        searchValue,
        statusValue,
        riskValue
    );


    filterTable(
        "recordsTable",
        searchValue,
        statusValue,
        riskValue
    );
}


function filterTable(
    tableId,
    searchValue,
    statusValue,
    riskValue
) {

    const table =
        document.getElementById(
            tableId
        );


    if (!table) {
        return;
    }


    const tbody =
        table.getElementsByTagName(
            "tbody"
        )[0];


    if (!tbody) {
        return;
    }


    const rows =
        tbody.getElementsByTagName(
            "tr"
        );


    for (let row of rows) {

        const text =
            row.innerText.toLowerCase();


        const rowStatus =
            (
                row.dataset.status ||
                ""
            ).toLowerCase();


        const matchesSearch =
            searchValue === "" ||
            text.includes(
                searchValue
            );


        const matchesStatus =
            statusValue === "" ||
            rowStatus ===
                statusValue;


        const matchesRisk =
            riskValue === "" ||
            text.includes(
                riskValue
            );


        if (
            matchesSearch &&
            matchesStatus &&
            matchesRisk
        ) {

            row.style.display = "";

        } else {

            row.style.display =
                "none";
        }
    }
}


function sortTables() {

    const sortValue =
        document
            .getElementById(
                "sortCases"
            )
            .value;


    sortTable(
        "priorityTable",
        sortValue
    );


    sortTable(
        "recordsTable",
        sortValue
    );
}


function sortTable(
    tableId,
    sortValue
) {

    const table =
        document.getElementById(
            tableId
        );


    if (!table) {
        return;
    }


    const tbody =
        table.querySelector(
            "tbody"
        );


    if (!tbody) {
        return;
    }


    const rows =
        Array.from(
            tbody.querySelectorAll(
                "tr"
            )
        );


    rows.sort(
        function (a, b) {

            const idA =
                Number(
                    a.dataset.id ||
                    0
                );

            const idB =
                Number(
                    b.dataset.id ||
                    0
                );


            const riskA =
                Number(
                    a.dataset.risk ||
                    0
                );

            const riskB =
                Number(
                    b.dataset.risk ||
                    0
                );


            const createdA =
                new Date(
                    a.dataset.created ||
                    0
                ).getTime();


            const createdB =
                new Date(
                    b.dataset.created ||
                    0
                ).getTime();


            if (
                sortValue ===
                "risk_desc"
            ) {

                return (
                    riskB -
                    riskA
                );
            }


            if (
                sortValue ===
                "risk_asc"
            ) {

                return (
                    riskA -
                    riskB
                );
            }


            if (
                sortValue ===
                "newest"
            ) {

                return (
                    createdB -
                    createdA
                );
            }


            if (
                sortValue ===
                "oldest"
            ) {

                return (
                    createdA -
                    createdB
                );
            }


            if (
                sortValue ===
                "id_asc"
            ) {

                return (
                    idA -
                    idB
                );
            }


            if (
                sortValue ===
                "id_desc"
            ) {

                return (
                    idB -
                    idA
                );
            }


            return 0;
        }
    );


    rows.forEach(
        function (row) {

            tbody.appendChild(
                row
            );
        }
    );
}


function clearFilters() {

    document.getElementById(
        "searchInput"
    ).value = "";


    document.getElementById(
        "statusFilter"
    ).value = "";


    document.getElementById(
        "riskFilter"
    ).value = "";


    document.getElementById(
        "sortCases"
    ).value = "risk_desc";


    filterTables();

    sortTables();
}


async function analysePost() {

    const platformInput =
        document.getElementById(
            "platformInput"
        );


    const usernameInput =
        document.getElementById(
            "usernameInput"
        );


    const displayNameInput =
        document.getElementById(
            "displayNameInput"
        );


    const locationInput =
        document.getElementById(
            "locationInput"
        );


    const postTextInput =
        document.getElementById(
            "postTextInput"
        );


    const resultBox =
        document.getElementById(
            "analysisResult"
        );


    const platform =
        platformInput.value.trim();


    const username =
        usernameInput.value.trim();


    const displayName =
        displayNameInput.value.trim();


    const publicLocation =
        locationInput.value.trim();


    const postText =
        postTextInput.value.trim();


    if (
        !platform ||
        !username ||
        !postText
    ) {

        resultBox.innerHTML = `
            <div class="result-box">

                <strong>
                    Please complete:
                </strong>

                platform,
                username and
                post text.

            </div>
        `;

        return;
    }


    resultBox.innerHTML = `
        <div class="result-box">
            Analysing...
        </div>
    `;


    try {

        const response =
            await fetch(
                "/analyse",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify(
                            {
                                platform:
                                    platform,

                                username:
                                    username,

                                display_name:
                                    displayName ||
                                    null,

                                post_text:
                                    postText,

                                public_location:
                                    publicLocation ||
                                    null
                            }
                        )
                }
            );


        const result =
            await response.json();


        if (
            !response.ok ||
            result.success ===
                false
        ) {

            resultBox.innerHTML = `
                <div class="result-box">

                    <strong>
                        Analysis failed.
                    </strong>

                    <br>

                    ${
                        result.error ||
                        result.message ||
                        "Unknown error"
                    }

                </div>
            `;

            return;
        }


        resultBox.innerHTML = `
            <div class="result-box">

                <h3>
                    Analysis Complete
                </h3>

                <p>
                    <strong>
                        Language:
                    </strong>

                    ${result.original_language}
                </p>

                <p>
                    <strong>
                        UK Relevant:
                    </strong>

                    ${result.uk_relevant}
                </p>

                <p>
                    <strong>
                        Severity:
                    </strong>

                    ${result.severity}
                </p>

                <p>
                    <strong>
                        Risk Score:
                    </strong>

                    ${result.risk_score}
                </p>

                <p>
                    <strong>
                        Risk Level:
                    </strong>

                    ${result.risk_level}
                </p>

                <p>
                    <strong>
                        Human Review Required:
                    </strong>

                    ${result.human_review_required}
                </p>

                <p>
                    <strong>
                        Detected Terms:
                    </strong>

                    ${
                        (
                            result.detected_terms ||
                            []
                        ).join(", ") ||
                        "None"
                    }
                </p>

                <p>
                    <strong>
                        Risk Indicators:
                    </strong>

                    ${
                        (
                            result.risk_indicators ||
                            []
                        ).join(", ") ||
                        "None"
                    }
                </p>

                <p>
                    <strong>
                        Saved to Database:
                    </strong>

                    ${result.saved_to_database}
                </p>

            </div>
        `;


        platformInput.value = "";

        usernameInput.value = "";

        displayNameInput.value = "";

        locationInput.value = "";

        postTextInput.value = "";


        setTimeout(
            function () {

                window.location.reload();

            },
            4000
        );


    } catch (error) {

        console.error(
            "Analysis error:",
            error
        );


        resultBox.innerHTML = `
            <div class="result-box">

                <strong>
                    Analysis error:
                </strong>

                <br>

                ${error.message}

            </div>
        `;
    }
}


let autoRefreshTimer =
    null;


function refreshDashboard() {

    window.location.reload();
}


function toggleAutoRefresh() {

    const toggle =
        document.getElementById(
            "autoRefreshToggle"
        );


    if (toggle.checked) {

        autoRefreshTimer =
            setInterval(
                function () {

                    window.location.reload();

                },
                30000
            );


        localStorage.setItem(
            "autoRefreshEnabled",
            "true"
        );

    } else {

        if (autoRefreshTimer) {

            clearInterval(
                autoRefreshTimer
            );

            autoRefreshTimer =
                null;
        }


        localStorage.setItem(
            "autoRefreshEnabled",
            "false"
        );
    }
}


function initialiseDashboardControls() {

    const toggle =
        document.getElementById(
            "autoRefreshToggle"
        );


    const lastRefresh =
        document.getElementById(
            "lastRefreshTime"
        );


    const enabled =
        localStorage.getItem(
            "autoRefreshEnabled"
        );


    if (lastRefresh) {

        lastRefresh.textContent =
            "Last refreshed: " +
            new Date()
                .toLocaleTimeString();
    }


    if (
        toggle &&
        enabled === "true"
    ) {

        toggle.checked =
            true;


        autoRefreshTimer =
            setInterval(
                function () {

                    window.location.reload();

                },
                30000
            );
    }


    sortTables();
}


document.addEventListener(
    "DOMContentLoaded",
    initialiseDashboardControls
);

</script>

