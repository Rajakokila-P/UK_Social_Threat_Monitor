@app.post("/profile")
async def update_profile_page(
    request: Request,
):
    user = get_current_user(
        request
    )

    if not user:
        return RedirectResponse(
            url="/login",
            status_code=303,
        )

    body = await request.body()

    form_data = parse_qs(
        body.decode("utf-8")
    )

    first_name = (
        form_data
        .get("first_name", [""])[0]
        .strip()
    )

    surname = (
        form_data
        .get("surname", [""])[0]
        .strip()
    )

    id_number = (
        form_data
        .get("id_number", [""])[0]
        .strip()
    )

    email = (
        form_data
        .get("email", [""])[0]
        .strip()
    )

    phone_number = (
        form_data
        .get("phone_number", [""])[0]
        .strip()
    )

    error = None

    if not first_name or not surname:
        error = (
            "First name and surname are required."
        )

    elif email and (
        "@" not in email
        or "." not in email.split("@")[-1]
    ):
        error = (
            "Please enter a valid email address."
        )

    if error:
        profile = {
            "id": user["id"],
            "username": user["username"],
            "role": user["role"],
            "first_name": first_name,
            "surname": surname,
            "id_number": id_number,
            "email": email,
            "phone_number": phone_number,
        }

        return templates.TemplateResponse(
            request,
        "profile.html",
            {
                "user": user,
                "profile": profile,
                "error": error,
                "success": None,
            },
            status_code=400,
        )

    result = update_user_profile(
        user["id"],
        first_name,
        surname,
        id_number,
        email,
        phone_number,
    )

    if not result.get("success"):
        profile = get_user_profile(
            user["id"]
        )

        return templates.TemplateResponse(
            request,
        "profile.html",
            {
                "user": user,
                "profile": profile,
                "error": result.get(
                    "message",
                    "Unable to update personal details.",
                ),
                "success": None,
            },
