# ANALYSE POST
# ---------------------------------------------------------

@app.post("/analyse")
def analyse_post(
    request: Request,
    post: SocialPost,
):

    user = require_api_user(
        request
    )

    require_role(
        user,
        {
            "ADMIN",
            "SENIOR_ANALYST",
            "ANALYST",
        },
    )

    try:
        initial_analysis = (
            analyse_threat(
                post.post_text
            )
        )

        translation = (
            translate_to_english(
                post.post_text,
                initial_analysis[
                    "language"
                ],
            )
        )

        analysis = analyse_threat(
            translation[
                "translated_text"
            ]
        )

        risk = calculate_risk_score(
            translation[
                "translated_text"
            ],
            analysis[
                "uk_relevant"
            ],
        )


        save_analysis(
            platform=
                post.platform,

            username=
                post.username,

            display_name=
                post.display_name,

            public_location=
                post.public_location,

            original_text=
                post.post_text,

            translated_text=
                translation[
                    "translated_text"
                ],

            translation_status=
                translation[
                    "translation_status"
                ],

            language=
                initial_analysis[
                    "language"
                ],

            uk_relevant=
                analysis[
                    "uk_relevant"
                ],

            severity=
                analysis[
                    "severity"
                ],

            risk_score=
                risk[
                    "risk_score"
                ],

            risk_level=
                risk[
                    "risk_level"
                ],

            risk_indicators=
                risk[
                    "risk_indicators"
                ],

            detected_terms=
                analysis[
                    "detected_terms"
                ],

            human_review_required=(
                risk["risk_score"]
                >= 25
            ),
        )


        log_security_event(
            user["username"],
            "ANALYSIS_CREATED",
            (
                "Analysis saved for platform "
                + post.platform
            ),
        )


        return {
            "platform":
                post.platform,

            "username":
                post.username,

            "display_name":
                post.display_name,

            "public_location":
                post.public_location,

            "original_text":
                post.post_text,

            "original_language":
                initial_analysis[
                    "language"
                ],

            "translated_text":
                translation[
                    "translated_text"
                ],

            "translation_status":
                translation[
                    "translation_status"
                ],

            "uk_relevant":
                analysis[
                    "uk_relevant"
                ],

            "severity":
                analysis[
                    "severity"
                ],

            "detected_terms":
                analysis[
                    "detected_terms"
                ],

            "risk_score":
                risk[
                    "risk_score"
                ],

            "risk_level":
                risk[
                    "risk_level"
                ],

            "risk_indicators":
                risk[
                    "risk_indicators"
                ],

            "human_review_required": (
                risk["risk_score"]
                >= 25
            ),

            "saved_to_database":
                True,
        }


    except Exception as error:

        traceback.print_exc()

        return {
            "success": False,
            "error_type":
                type(
                    error
                ).__name__,
            "error":
                str(error),
        }


