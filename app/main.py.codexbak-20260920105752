@app.get("/export/cases.csv")
def export_cases_csv(
    request: Request,
):

    user = require_api_user(
        request
    )

    require_role(
        user,
        {
            "ADMIN",
            "SENIOR_ANALYST",
        },
    )

    try:
        records = (
            get_all_records()
        )

        output = io.StringIO()

        fieldnames = [
            "id",
            "platform",
            "username",
            "display_name",
            "public_location",
            "original_text",
            "translated_text",
            "language",
            "uk_relevant",
            "severity",
            "risk_score",
            "risk_level",
            "case_status",
            "analyst_notes",
            "created_at",
        ]


        writer = csv.DictWriter(
            output,
            fieldnames=
                fieldnames,
            extrasaction=
                "ignore",
        )


        writer.writeheader()


        for record in records:
            writer.writerow(
                record
            )


        csv_content = (
            output.getvalue()
        )

        output.close()


        log_security_event(
            user["username"],
            "CSV_EXPORTED",
            (
                "Exported "
                + str(
                    len(records)
                )
                + " cases"
            ),
        )


        return StreamingResponse(
            iter(
                [csv_content]
            ),

            media_type=
                "text/csv",

            headers={
                "Content-Disposition":
                    "attachment; "
                    "filename=threat_cases.csv"
            },
        )


    except Exception as error:

        traceback.print_exc()

        return {
            "success": False,

            "error_type":
                type(
                    error
                ).__name__,

            "error":
                str(error),
