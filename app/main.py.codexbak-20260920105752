@app.post("/forgot-password")
async def forgot_password_submit(
    request: Request,
):
    if get_current_user(request):
        return RedirectResponse(
            url="/dashboard",
            status_code=303,
        )

    body = await request.body()
    form_data = parse_qs(
        body.decode("utf-8")
    )

    username = (
        form_data.get("username", [""])[0].strip()
    )
    email = (
        form_data.get("email", [""])[0].strip()
    )
    new_password = form_data.get(
        "new_password", [""]
    )[0]
    confirm_password = form_data.get(
        "confirm_password", [""]
    )[0]

    if (
        not username
        or not email
        or not new_password
        or not confirm_password
    ):
        return templates.TemplateResponse(
            request,
        "forgot_password.html",
            {
                "error":
                    "Please complete all recovery fields.",
                "success": None,
            },
            status_code=400,
        )

    if len(new_password) < 12:
        return templates.TemplateResponse(
            request,
        "forgot_password.html",
            {
                "error":
                    "The new password must contain at least 12 characters.",
                "success": None,
            },
            status_code=400,
        )

    if new_password != confirm_password:
        return templates.TemplateResponse(
            request,
        "forgot_password.html",
            {
                "error":
                    "The new passwords do not match.",
                "success": None,
            },
            status_code=400,
        )

    result = reset_password_with_email(
        username,
        email,
        new_password,
    )

    if not result.get("success"):
        log_security_event(
            username or "UNKNOWN",
            "PASSWORD_RECOVERY_FAILED",
            "Recovery details did not match",
        )

        return templates.TemplateResponse(
            request,
        "forgot_password.html",
            {
                "error":
                    "Recovery could not be completed. Check the username and recovery email.",
                "success": None,
            },
            status_code=400,
        )

    log_security_event(
        result["username"],
        "PASSWORD_RECOVERY_SUCCESS",
        "Password reset using local recovery flow",
    )

    return templates.TemplateResponse(
        request,
        "forgot_password.html",
        {
            "error": None,
            "success":
                "Password reset successfully. You can now sign in with your new password.",
        },
    )

